#include <Servo.h>

Servo myServo;  

int openAngle = 0;   // زاوية فتح المصيدة (السمكة تحت)
int closeAngle = 180; // زاوية قفل المصيدة (السمكة فوق)

void setup() {
  Serial.begin(9600); 
  myServo.attach(3);  // السيرفو موصل بمنفذ 9
  myServo.write(openAngle); // افتح المصيدة أول ما يشتغل
}

void loop() {
  if (Serial.available() > 0) {
    char command = Serial.read();
    
    if (command == '1') {
      myServo.write(closeAngle); // السمكة فوق -> قفل السيرفو
    } 
    else if (command == '0') {
      myServo.write(openAngle);  // السمكة تحت -> افتح السيرفو
    }
  }
}

